    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "zip": "zip -X -r project-export.zip . -x 'node_modules/*' -x '.git/*' -x 'dist/*' -x '.env' -x '*.zip' -x '.DS_Store' -x '__MACOSX/*' -x '*.db*'"
  },
  "keywords": [],
